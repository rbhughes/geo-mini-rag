# Copy to .env and fill in. .env is gitignored.
OPENROUTER_API_KEY=

# Optional: sent to OpenRouter so calls are attributed to this app on your dashboard
OPENROUTER_APP_NAME=geo-mini-rag
OPENROUTER_APP_URL=https://purr.io

# Where the drive of documents lives. Can be a local path or any fsspec URL (s3://, file://, ...)
GEO_DOCS_ROOT=data/raw
